#!/bin/bash

# Create a desktop launcher for a web app
# Usage: webapp-install [name url icon-url-or-name [custom-exec] [mime-types]]

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

safe_icon_name() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

require_plain_name() {
  if [[ $1 == */* ]]; then
    echo "App name cannot contain '/': $1"
    exit 1
  fi
}

normalize_webapp_url() {
  local url=$1

  if [[ ! $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    url="https://$url"
  fi

  printf '%s' "$url"
}

require_http_url() {
  local url=$1

  if [[ $url =~ [[:space:]] ]]; then
    echo "Error: web app URL must not contain whitespace." >&2
    exit 1
  fi

  if [[ ! ${url,,} =~ ^https?:// ]]; then
    echo "Error: web app URL must be http or https." >&2
    exit 1
  fi
}

download_icon() {
  curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
    [[ -s $2 ]] &&
    [[ $(file -b --mime-type "$2") == image/* ]]
}

fetch_site_icon() {
  local site_url="$1"
  local dest="$2"
  local origin
  local page
  local icon_url

  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")

  page=$(
    curl -fsSL --max-time 5 "$site_url" 2>/dev/null |
      head -c 100000 |
      tr '\n' ' '
  ) || true

  icon_url=$(
    grep -oiE '<link[^>]*rel=["'\''][^"'\'']*apple-touch-icon[^"'\'']*["'\''][^>]*>' <<<"$page" |
      grep -oiE 'href=["'\''][^"'\'']+' |
      head -1 |
      sed -E 's/^href=["'\'']//'
  ) || true

  case $icon_url in
    http://*|https://*) ;;
    //*) icon_url="https:$icon_url" ;;
    /*) icon_url="$origin$icon_url" ;;
    ?*) icon_url="$origin/$icon_url" ;;
  esac

  { [[ -n $icon_url ]] && download_icon "$icon_url" "$dest"; } ||
    download_icon "$origin/apple-touch-icon.png" "$dest" ||
    download_icon "https://www.google.com/s2/favicons?domain=${site_url}&sz=256" "$dest"
}

desktop_string_escape() {
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  [[ $value == " "* ]] && value="\\s${value# }"

  printf '%s' "$value"
}

desktop_exec_arg() {
  local escaped

  escaped=$(printf '%s' "$1" |
    sed -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g' \
        -e 's/`/\\`/g' \
        -e 's/\$/\\$/g' \
        -e 's/%/%%/g')

  printf '"%s"' "$escaped"
}

if (( $# < 3 )); then
  echo -e "\e[32mLet's create a new web app you can start with the app launcher.\n\e[0m"

  APP_NAME=$(gum input \
    --prompt "Name> " \
    --placeholder "My favorite web app")

  require_plain_name "$APP_NAME"

  APP_URL=$(gum input \
    --prompt "URL> " \
    --placeholder "https://example.com")

  APP_URL=$(normalize_webapp_url "$APP_URL")
  require_http_url "$APP_URL"

  mkdir -p "$ICON_DIR"

  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  AUTO_ICON="$ICON_DIR/$ICON_VALUE.png"

  if fetch_site_icon "$APP_URL" "$AUTO_ICON"; then
    # The icon is already installed. Do not copy it again.
    ICON_REF="$ICON_VALUE"
  else
    ICON_REF=$(gum input \
      --prompt "Icon URL/name> " \
      --placeholder "PNG icon URL or icon name")
  fi

  CUSTOM_EXEC=""
  MIME_TYPES=""
  INTERACTIVE_MODE=true
else
  APP_NAME="$1"
  APP_URL=$(normalize_webapp_url "$2")
  require_http_url "$APP_URL"

  ICON_REF="$3"
  CUSTOM_EXEC="${4:-}"
  MIME_TYPES="${5:-}"
  INTERACTIVE_MODE=false
fi

[[ -n $APP_NAME && -n $APP_URL ]] || {
  echo "You must set app name and app URL!"
  exit 1
}

require_plain_name "$APP_NAME"

if [[ -z $ICON_REF ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"

  fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png" || {
    echo "Error: failed to download icon."
    exit 1
  }

elif [[ $ICON_REF =~ ^https?:// ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"

  download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png" || {
    echo "Error: failed to download icon."
    exit 1
  }

elif [[ -f $ICON_REF ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  ext="${ICON_REF##*.}"
  [[ $ext == "$ICON_REF" ]] && ext="png"

  mkdir -p "$ICON_DIR"
  cp "$ICON_REF" "$ICON_DIR/$ICON_VALUE.$ext"
  ICON_VALUE="$ICON_VALUE.$ext"

else
  ICON_VALUE=$(basename "$ICON_REF")
  [[ $ICON_VALUE == *.* ]] &&
    ICON_VALUE="${ICON_VALUE%.*}"
fi

if [[ -n $CUSTOM_EXEC ]]; then
  EXEC_COMMAND="$CUSTOM_EXEC"
else
  EXEC_COMMAND="webapp $(desktop_exec_arg "$APP_URL")"
fi

DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"
mkdir -p "$DESKTOP_DIR"

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$(desktop_string_escape "$APP_NAME")
Comment=$(desktop_string_escape "$APP_NAME")
Exec=$(desktop_string_escape "$EXEC_COMMAND")
Terminal=false
Type=Application
Icon=$(desktop_string_escape "$ICON_VALUE")
StartupNotify=true
X-WebApp=true
EOF

if [[ -n $MIME_TYPES ]]; then
  printf 'MimeType=%s\n' "$(desktop_string_escape "$MIME_TYPES")" >>"$DESKTOP_FILE"
fi

chmod +x "$DESKTOP_FILE"

if [[ $INTERACTIVE_MODE == true ]]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"
fi
