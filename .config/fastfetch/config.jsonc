{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "break",
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
    },
    "break",
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    "break",
    {
      "type": "memory",
      "key": "󰍛 RAM"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "break",
    {
      "type": "command",
      "key": "󰐊 Media",
      "text": "if command -v playerctl >/dev/null 2>&1; then playerctl metadata --format '{{status}}: {{artist}} - {{title}}' 2>/dev/null || printf 'Nothing is playing'; else printf 'Nothing is playing'; fi"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}
